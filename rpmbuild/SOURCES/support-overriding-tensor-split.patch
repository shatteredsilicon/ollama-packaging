diff --git a/envconfig/override.go b/envconfig/override.go
new file mode 100644
index 0000000..5a288d5
--- /dev/null
+++ b/envconfig/override.go
@@ -0,0 +1,121 @@
+package envconfig
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+// Override contains per-model llama-server launch overrides.
+type Override struct {
+	ModelName    string
+	NumGPULayers int
+	TensorSplit  []int
+}
+
+// LoadOverride loads the override for model from an INI file.
+//
+// The supported format is:
+//
+//	[model-name]
+//	tensor-split=20,20,20,20
+//
+// TensorSplit values are passed to llama-server in layer split mode. Because
+// NumGPULayers is their sum, each value is the exact number of offloaded layers
+// assigned to the corresponding GPU.
+func LoadOverride(model string) (*Override, error) {
+	if model == "" {
+		return nil, nil
+	}
+
+	path := OverrideConfigPath()
+	if path == "" {
+		home, err := os.UserHomeDir()
+		if err != nil || home == "" {
+			return nil, nil
+		}
+		path = filepath.Join(home, ".ollama.ini")
+	}
+
+	f, err := os.Open(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	} else if err != nil {
+		return nil, fmt.Errorf("open override config %q: %w", path, err)
+	}
+	defer f.Close()
+
+	section := "[" + model + "]"
+	inSection := false
+	lineNumber := 0
+
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		lineNumber++
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, ";") {
+			continue
+		}
+
+		if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
+			inSection = line == section
+			continue
+		}
+		if !inSection {
+			continue
+		}
+
+		key, value, ok := strings.Cut(line, "=")
+		if !ok || !strings.EqualFold(strings.TrimSpace(key), "tensor-split") {
+			continue
+		}
+
+		split, err := parsePositiveIntList(value)
+		if err != nil {
+			return nil, fmt.Errorf("parse override config %q line %d: %w", path, lineNumber, err)
+		}
+
+		total := 0
+		for _, layers := range split {
+			if total > math.MaxInt-layers {
+				return nil, fmt.Errorf("parse override config %q line %d: tensor-split sum overflows int", path, lineNumber)
+			}
+			total += layers
+		}
+
+		return &Override{
+			ModelName:    model,
+			NumGPULayers: total,
+			TensorSplit:  split,
+		}, nil
+	}
+
+	if err := scanner.Err(); err != nil {
+		return nil, fmt.Errorf("read override config %q: %w", path, err)
+	}
+
+	return nil, nil
+}
+
+func parsePositiveIntList(value string) ([]int, error) {
+	parts := strings.Split(strings.TrimSpace(value), ",")
+	if len(parts) == 0 || (len(parts) == 1 && strings.TrimSpace(parts[0]) == "") {
+		return nil, errors.New("tensor-split must contain at least one positive integer")
+	}
+
+	values := make([]int, 0, len(parts))
+	for _, part := range parts {
+		part = strings.TrimSpace(part)
+		value, err := strconv.Atoi(part)
+		if err != nil || value <= 0 {
+			return nil, fmt.Errorf("tensor-split value %q must be a positive integer", part)
+		}
+		values = append(values, value)
+	}
+	return values, nil
+}
diff --git a/envconfig/override_test.go b/envconfig/override_test.go
new file mode 100644
index 0000000..f1feca6
