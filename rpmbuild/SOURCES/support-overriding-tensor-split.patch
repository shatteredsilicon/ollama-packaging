@@ -0,0 +1,109 @@
+package envconfig
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestParsePositiveIntList(t *testing.T) {
+	tests := []struct {
+		name    string
+		value   string
+		want    []int
+		wantErr bool
+	}{
+		{name: "single", value: "4", want: []int{4}},
+		{name: "multiple", value: " 10, 20,30 ", want: []int{10, 20, 30}},
+		{name: "empty", value: "", wantErr: true},
+		{name: "zero", value: "1,0", wantErr: true},
+		{name: "negative", value: "1,-2", wantErr: true},
+		{name: "invalid", value: "1,two", wantErr: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := parsePositiveIntList(tt.value)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("parsePositiveIntList(%q) error = %v, wantErr %v", tt.value, err, tt.wantErr)
+			}
+			if len(got) != len(tt.want) {
+				t.Fatalf("parsePositiveIntList(%q) = %v, want %v", tt.value, got, tt.want)
+			}
+			for i := range got {
+				if got[i] != tt.want[i] {
+					t.Fatalf("parsePositiveIntList(%q) = %v, want %v", tt.value, got, tt.want)
+				}
+			}
+		})
+	}
+}
+
+func TestLoadOverride(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "ollama.ini")
+	if err := os.WriteFile(path, []byte(`
+; comment
+[other]
+tensor-split=1
+
+[llama3.2-vision:90b]
+tensor-split=10,20,30
+`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("OLLAMA_OVERRIDE_CONFIG", path)
+
+	override, err := LoadOverride("llama3.2-vision:90b")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if override == nil {
+		t.Fatal("LoadOverride returned nil")
+	}
+	if override.NumGPULayers != 60 {
+		t.Fatalf("NumGPULayers = %d, want 60", override.NumGPULayers)
+	}
+	want := []int{10, 20, 30}
+	for i := range want {
+		if override.TensorSplit[i] != want[i] {
+			t.Fatalf("TensorSplit = %v, want %v", override.TensorSplit, want)
+		}
+	}
+}
+
+func TestLoadOverrideMissingSectionOrFile(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "ollama.ini")
+	if err := os.WriteFile(path, []byte("[other]\ntensor-split=1\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("OLLAMA_OVERRIDE_CONFIG", path)
+
+	override, err := LoadOverride("missing")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if override != nil {
+		t.Fatalf("LoadOverride returned %#v, want nil", override)
+	}
+
+	t.Setenv("OLLAMA_OVERRIDE_CONFIG", filepath.Join(t.TempDir(), "missing.ini"))
+	override, err = LoadOverride("other")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if override != nil {
+		t.Fatalf("LoadOverride returned %#v, want nil", override)
+	}
+}
+
+func TestLoadOverrideRejectsInvalidTensorSplit(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "ollama.ini")
+	if err := os.WriteFile(path, []byte("[model]\ntensor-split=1,0,2\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("OLLAMA_OVERRIDE_CONFIG", path)
+
+	if _, err := LoadOverride("model"); err == nil {
+		t.Fatal("LoadOverride succeeded, want an error")
+	}
+}
