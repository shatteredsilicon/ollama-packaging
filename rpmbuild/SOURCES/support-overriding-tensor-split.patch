+func selectTensorSplitPlacement(systemInfo ml.SystemInfo, gpus []ml.DeviceInfo, count int) ([]ml.DeviceInfo, bool) {
+	if count <= 0 {
+		return nil, false
+	}
+
+	candidates := make([][]ml.DeviceInfo, 0)
+	for _, group := range ml.ByLibrary(gpus) {
+		if len(group) < count || len(group) == 0 || strings.EqualFold(group[0].Library, "cpu") {
+			continue
+		}
+		candidates = append(candidates, group[:count])
+	}
+	if len(candidates) == 0 {
+		return nil, false
+	}
+
+	selected := bestGPUGroupByAvailableMemory(systemInfo, candidates)
+	return selected, len(selected) == count
+}
