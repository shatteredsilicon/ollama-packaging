+func appendGPUOffloadArgs(params []string, numGPU int, tensorSplit []int) []string {
+	// Default behavior leaves GPU layer selection to llama-server via -ngl auto.
+	if numGPU > 0 {
+		params = append(params, "-ngl", strconv.Itoa(numGPU))
+	} else if numGPU == 0 {
+		params = append(params, "-ngl", "0")
+	}
+
+	if len(tensorSplit) > 0 {
+		values := make([]string, len(tensorSplit))
+		for i, layers := range tensorSplit {
+			values[i] = strconv.Itoa(layers)
+		}
+		params = append(params, "--split-mode", "layer", "--tensor-split", strings.Join(values, ","))
+	}
+
+	return params
+}
